<UserControl x:Class="ScreenToGif.Controls.StudioBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" Unloaded="OnUnloaded" IsVisibleChanged="OnVisibilityChanged">
    <Border x:Name="Card" Visibility="Collapsed" Margin="5" Background="#171943" CornerRadius="4" Padding="8">
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="×" ToolTip="关闭横幅" AutomationProperties.Name="关闭横幅"
                    Width="28" Height="28" VerticalAlignment="Center" Click="Dismiss"/>
            <Button Click="OpenTarget" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left">
                <DockPanel>
                    <Image x:Name="Artwork" Width="62" Height="38" Stretch="Uniform" Margin="0,0,8,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="开枝工作室 · 自营" Foreground="#FFAF98" FontSize="11"/>
                        <TextBlock x:Name="Headline" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
            </Button>
        </DockPanel>
    </Border>
</UserControl>
